# Required local authentication. Generate with: openssl rand -hex 32
SPEKO_LOCAL_AUTH_TOKEN=

# Optional. Enables managed routing/relay; explicitly requested BYOK sessions
# still use the local credentials below.
SPEKO_API_KEY=

# Optional BYOK provider credentials. At least one is required without a Speko key.
SPEKO_ALIBABA_BYOK_API_KEY=
SPEKO_ASSEMBLYAI_BYOK_API_KEY=
SPEKO_CARTESIA_BYOK_API_KEY=
SPEKO_DEEPGRAM_BYOK_API_KEY=
SPEKO_ELEVENLABS_BYOK_API_KEY=
SPEKO_GLADIA_BYOK_API_KEY=
# Google requires an OAuth access token. The _FILE form is reread per session,
# allowing an external token refresher to rotate it without a Gateway restart.
SPEKO_GOOGLE_BYOK_ACCESS_TOKEN=
SPEKO_GOOGLE_STT_ENDPOINT=
SPEKO_GRADIUM_BYOK_API_KEY=
SPEKO_HUME_BYOK_API_KEY=
SPEKO_INWORLD_BYOK_API_KEY=
SPEKO_MINIMAX_BYOK_API_KEY=
SPEKO_OPENAI_BYOK_API_KEY=
SPEKO_RIME_BYOK_API_KEY=
SPEKO_SMALLEST_BYOK_API_KEY=
SPEKO_SONIOX_BYOK_API_KEY=
SPEKO_XAI_BYOK_API_KEY=

# Optional provider-specific default voices for BYOK TTS. The request's voice
# still wins. Use SPEKO_<PROVIDER>_BYOK_TTS_VOICE for any TTS provider.
SPEKO_ALIBABA_BYOK_TTS_VOICE=
SPEKO_CARTESIA_BYOK_TTS_VOICE=
SPEKO_DEEPGRAM_BYOK_TTS_VOICE=
SPEKO_ELEVENLABS_BYOK_TTS_VOICE=
SPEKO_GOOGLE_BYOK_TTS_VOICE=
SPEKO_GRADIUM_BYOK_TTS_VOICE=
SPEKO_HUME_BYOK_TTS_VOICE=
SPEKO_INWORLD_BYOK_TTS_VOICE=
SPEKO_MINIMAX_BYOK_TTS_VOICE=
SPEKO_OPENAI_BYOK_TTS_VOICE=
SPEKO_RIME_BYOK_TTS_VOICE=
SPEKO_SMALLEST_BYOK_TTS_VOICE=
SPEKO_SONIOX_BYOK_TTS_VOICE=
SPEKO_XAI_BYOK_TTS_VOICE=

# Anonymous, content-free usage telemetry is on by default. Set true to opt out.
SPEKO_TELEMETRY_DISABLED=false

SPEKO_GATEWAY_TAG=latest
