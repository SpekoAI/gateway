# Required local authentication. Generate with: openssl rand -hex 32
SPEKO_LOCAL_AUTH_TOKEN=

# Leave unset for local BYOK routing. Set to use Speko-managed routing.
SPEKO_API_KEY=

# Optional BYOK provider credentials. At least one is required without a Speko key.
SPEKO_DEEPGRAM_BYOK_API_KEY=
SPEKO_ELEVENLABS_BYOK_API_KEY=
SPEKO_CARTESIA_BYOK_API_KEY=

# Anonymous, content-free usage telemetry is on by default. Set true to opt out.
SPEKO_TELEMETRY_DISABLED=false

SPEKO_GATEWAY_TAG=latest
